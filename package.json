{
  "name": "personal-workbench",
  "productName": "拾光工作台",
  "version": "0.1.0",
  "private": true,
  "description": "离线优先的个人桌面工作台：待办、笔记与常用链接",
  "author": "Personal Workbench",
  "license": "MIT",
  "type": "module",
  "main": "./out/main/index.cjs",
  "scripts": {
    "dev": "node scripts/dev.cjs",
    "preview": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit",
    "build": "node scripts/build.cjs",
    "test": "node scripts/test.cjs",
    "test:ui": "node scripts/smoke.cjs",
    "icons": "node scripts/icons.cjs",
    "postinstall": "electron-builder install-app-deps",
    "dist": "node scripts/build.cjs dist",
    "pack": "node scripts/build.cjs pack"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "better-sqlite3": "^12.4.1",
    "element-plus": "^2.11.5",
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.10",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "42.11.16",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "playwright": "^1.56.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.1.1"
  },
  "build": {
    "appId": "local.personal.workbench",
    "productName": "拾光工作台",
    "directories": {
      "output": "release",
      "buildResources": "resources"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "win": {
      "icon": "resources/icon.ico",
      "target": "nsis",
      "executableName": "PersonalWorkbench"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "PersonalWorkbench-${version}-Setup.${ext}",
      "installerLanguages": [
        "zh_CN",
        "en_US"
      ]
    }
  }
}
